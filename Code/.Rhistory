# Check if increasing order lowers variance
incOrd <- data[order(data$PropWater), ] # Increasing order
rownames(incOrd) <- 1:nrow(incOrd)
n <- 50
N <- 1000
sysVars <- numeric(N)
srsVars <- numeric(N)
sysMeans <- numeric(N)
srsMeans <- numeric(N)
for (i in 1:N) {
sysSamp <- sys(incOrd, n)$PropWater
srsSamp <- incOrd[sample(1:nrow(incOrd), n), ]$PropWater
sysMeans[i] <- mean(sysSamp)
sysVars[i] <- var(sysSamp)
srsMeans[i] <- mean(srsSamp)
srsVars[i] <- var(srsSamp)
}
matrix(c(mean(sysVars), mean(srsVars), var(incOrd$PropWater),
var(sysMeans), var(srsMeans), 0),
nrow = 2, byrow = TRUE,
dimnames = list(c("Mean of Variance", "Variance of Mean"),
c("Systematic Sample", "SRS", "Population")))
