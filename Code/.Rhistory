# Create a systematic sampling function
sys <- function(df, n){
N <- nrow(df)
k <- ceiling(N/n)
sampleIndices <- numeric(n)
R <- sample(1:k, 1)
index <- R # Starting index
for (i in 1:n) { # To take n indices,
if (index > N) { # Check if out of bounds
index <- index - N # Loop back if so.
}
sampleIndices[i] <- index # take index into sample
index <- index + k
}
return(df[sampleIndices, ])
}
# Comparison of sampling statistics for sample mean
set.seed(22122022)
data <- read.csv("WaterData.csv")
randOrd <- data[sample(1:nrow(data)), ]
n <- 50 # sample size
N <- 1000 # Number of samples
sysMeans <- numeric(N)
srsMeans <- numeric(N)
for (i in 1:N) {
sysMeans[i] <- mean(sys(randOrd, n)$PropWater)
srsMeans[i] <- mean(randOrd[sample(1:nrow(randOrd), n), ]$PropWater)
}
matrix(c(mean(srsMeans), mean(sysMeans), mean(randOrd$PropWater),
var(srsMeans), var(sysMeans), 0), nrow = 2, ncol = 3, byrow = TRUE,
dimnames = list(c("Mean of yBar", "Variance of yBar"),
c("SRS", "Systematic Sample", "Population Mean")))
# Histogram of sample mean (not good)
par(mfrow = c(1,2))
hist(sysMeans, breaks = 20, main = "Histogram of sample\n mean for systematic\n sampling with n = 50",
xlab = "Sample mean")
hist(srsMeans, breaks = 20, main = "Histogram of sample\n mean for SRS\n sampling with n = 50",
xlab = "Sample mean")
# Investigate how a change in samplw size can make it better
n <- 10 # sample size
sysMeans <- rep(0, N)
srsMeans <- rep(0, N)
for (i in 1:N) {
sysMeans[i] <- mean(sys(randOrd, n)$PropWater)
srsMeans[i] <- mean(randOrd[sample(1:nrow(randOrd), n), ]$PropWater)
}
par(mfrow = c(1,2))
hist(sysMeans, breaks = 20, main = "Histogram of sample\n mean for systematic\n sampling with n = 10",
xlab = "Sample mean")
hist(srsMeans, breaks = 20, main = "Histogram of sample\n mean for SRS\n sampling with n = 10",
xlab = "Sample mean")
# Look at behavior of sample itself with changing sample size
