srsData1 <- randOrd[sample(1:nrow(randOrd), n[1]), ]$PropWater
sysData2 <- sys(randOrd, n[2])$PropWater
srsData2 <- randOrd[sample(1:nrow(randOrd), n[2]), ]$PropWater
sysData3 <- sys(randOrd, n[3])$PropWater
srsData3 <- randOrd[sample(1:nrow(randOrd), n[3]), ]$PropWater
sysData4 <- sys(randOrd, n[4])$PropWater
srsData4 <- randOrd[sample(1:nrow(randOrd), n[4]), ]$PropWater
